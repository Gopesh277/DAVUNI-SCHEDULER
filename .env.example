# Copy to .env (never commit .env) and fill in.

# REQUIRED: the campus IP address and/or hostname(s) people use to open the app,
# comma separated. HTTPS certificates are issued for exactly these names.
SERVER_NAME=10.20.1.15

# Login shared by every department until each chooses its own. With the default
# admin / admin123, each department is forced to choose a new password the first
# time it signs in.
APP_USERNAME=admin
APP_PASSWORD=admin123

# Optional per-department logins (ID from backend/departments.json, upper case):
# APP_PASSWORD_CIVIL=...
# APP_USERNAME_CIVIL=...
